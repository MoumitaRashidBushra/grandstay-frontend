{
  "name": "grandstay-e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Playwright end-to-end tests for the GrandStay frontend and backend.",
  "scripts": {
    "test": "cross-env TEST_ENV=local playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:local:ui": "cross-env TEST_ENV=local playwright test --project=chromium",
    "test:staging": "cross-env TEST_ENV=staging playwright test --grep @smoke",
    "test:staging:all": "cross-env TEST_ENV=staging playwright test",
    "test:headed": "cross-env TEST_ENV=local playwright test --project=chromium --headed",
    "test:debug": "cross-env TEST_ENV=local playwright test --project=chromium --debug",
    "ui": "cross-env TEST_ENV=local playwright test --ui",
    "report": "playwright show-report",
    "codegen": "playwright codegen http://localhost:5173",
    "install:browsers": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.7",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2"
  }
}
