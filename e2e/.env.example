# Copy to .env.local or .env.staging (both git-ignored).
# The file matching TEST_ENV is loaded by playwright.config.ts.
# Shell environment variables always win over values in the file.

# ---------- local ----------
# Frontend (Vite) and backend (NestJS) URLs.
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000/api/v1

# Start the apps automatically from ../grandstay-frontend and
# ../grandstay-backend. Set to false if you already run them yourself.
START_FRONTEND=true
# The backend needs PostgreSQL running (docker compose up -d in the backend).
START_BACKEND=false

# ---------- staging ----------
# FRONTEND_URL=https://staging.grandstay.example
# API_URL=https://staging-api.grandstay.example/api/v1

# ---------- test accounts ----------
# Tests that log in are skipped when these are empty.
# The backend seed (prisma/seed.js) creates admin@grandstay.example.
# Use dedicated test accounts on staging, never real users.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CUSTOMER_EMAIL=
CUSTOMER_PASSWORD=
RECEPTIONIST_EMAIL=
RECEPTIONIST_PASSWORD=